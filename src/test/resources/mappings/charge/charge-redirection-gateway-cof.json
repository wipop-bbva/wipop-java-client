{
  "priority": 1,
  "request": {
    "urlPathPattern": "/c/v1/m00000000000000000/charges",
    "method": "POST",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.order_id",
          "equalTo": "1234abcdefgh"
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.product_type",
          "equalTo": "payment_gateway",
          "caseInsensitive": true
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.origin_channel",
          "equalTo": "API",
          "caseInsensitive": true
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.terminal.id",
          "equalTo": "2"
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.use_cof",
          "equalTo": "true"
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.source_id",
          "absent": true
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "bodyFileName": "./charge/charge-redirection-gateway-cof.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
